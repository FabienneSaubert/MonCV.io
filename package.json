{
  "name": "moncv-io",
  "version": "1.0.0",
  "private": true,
  "description": "CV en ligne - Fabienne Saubert",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || echo \"hook git non configure (pas un depot git)\"",
